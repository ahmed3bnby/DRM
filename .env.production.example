# ─────────────────────────────────────────────────────────────────────────────
# DRM — production environment (self-hosted VPS: PM2 + Nginx + local PostgreSQL)
#
# Copy this file to  .env.production.local  on the server and fill the values:
#     cp .env.production.example .env.production.local
# Next.js and the sync/monitoring scripts both read .env.production.local first.
# Keep this file out of git with real secrets (.gitignore already excludes *.local).
# ─────────────────────────────────────────────────────────────────────────────


# ===== Core runtime (REQUIRED) =====

# Production mode (secure cookies + Next.js optimizations). `next start` sets this
# automatically, but set it explicitly for the background scripts too.
NODE_ENV=production

# Self-hosted mode marker. On a VPS this MUST be "local" — it enables the in-app
# "pull sources now" button and the sync/monitoring scripts. (It is NOT about the
# machine being localhost; it means "this box runs its own background jobs".)
APP_ENV=local

# Public HTTPS origin of the site. The https: prefix turns on Secure cookies.
APP_ORIGIN=https://drmuae.systems

# App database connection — the LOW-privilege application role (mizan_app).
# Local Postgres on the same VPS (no SSL needed over the loopback):
#   postgresql://mizan_app:<password>@127.0.0.1:5432/mizan?sslmode=disable
# Use an alphanumeric password (special chars like ? @ break URL parsing).
DATABASE_URL=

# Owner/admin database role — can CREATE ROLE/extensions and run migrations.
# Used by: npm run db:setup, the source sync, and the monitoring runner.
#   postgresql://<owner>:<password>@127.0.0.1:5432/mizan?sslmode=disable
DATABASE_ADMIN_URL=


# ===== Scheduled jobs: monitoring cron (REQUIRED for 24/7 monitoring) =====

# Shared secret for the POST /api/cron/monitoring endpoint. REQUIRED — the endpoint
# fails closed (HTTP 500) when this is missing. Generate a random value:
#   openssl rand -hex 32
# NOTE: the in-cron monitoring run (sync-cron.sh → run-monitoring.ts) does NOT need
# this — it calls the DB directly. CRON_SECRET only guards the HTTP endpoint, in case
# you trigger monitoring over HTTP instead.
CRON_SECRET=

# Optional: actor UUID recorded as the author of scheduled source-sync audit events.
# SYNC_ACTOR_ID=


# ===== Super admin (platform owner) =====

# Comma-separated user UUIDs that are platform owners (see /platform, /admin, and
# get every feature). After seeding, find yours with:
#   SELECT id FROM users WHERE email='you@example.com';
PLATFORM_ADMIN_USER_IDS=

# Optional: also recognise platform owners by email (comma-separated, lowercase).
# PLATFORM_ADMIN_EMAILS=


# ===== First-time database seeding (set when you run `npm run db:setup`) =====

# Password for the seeded admin account (min 12 chars). Change it, then change the
# password from the UI after first login.
DEMO_PASSWORD=

# Start CLEAN in production: organization + admin user only, NO demo customers.
SEED_DEMO_CUSTOMERS=0

# Only needed if DATABASE_ADMIN_URL points at a REMOTE/managed DB (e.g. Neon).
# For a local Postgres on the VPS, leave this unset.
# ALLOW_REMOTE_DB_SETUP=1


# ===== Optional integrations =====

# Send compliance alerts to Slack / Teams / Discord / internal webhook. If unset,
# alerts are only recorded in-app (the dispatcher reports delivered=false).
# COMPLIANCE_WEBHOOK_URL=

# Lock the whole app to localhost (blocks remote access). Leave UNSET in production.
# APP_RESTRICT_LOCALHOST=true


# ===== Not required (dormant features — leave unset) =====
# These power code paths that are not wired into the main screening flow:
#   OPENSANCTIONS_API_KEY=   # optional live OpenSanctions API lookup (unused)
#   HIBP_API_KEY=            # optional Have I Been Pwned breach check (unused)
# And these are only for a Vercel/Neon deployment, not the VPS:
#   NEON_DATABASE_URL= / NEON_POSTGRES_URL= / POSTGRES_URL=
