# ─────────────────────────────────────────────────────────────────────────────
# NBN / DRM — environment variables
# Copy the values you need. On Vercel, set the "Vercel runtime" group in the
# project's Environment Variables. Use the "Local seeding" group only on your
# own machine to migrate + seed the database and import source lists.
# ─────────────────────────────────────────────────────────────────────────────

# ===== Vercel runtime (the deployed web app) =====

# App database connection — the low-privilege application role (mizan_app).
# Neon: use the POOLED connection string. Must include ?sslmode=require.
#   postgresql://mizan_app:<password>@<neon-host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Public origin of the deployment, e.g. https://your-app.vercel.app or your domain.
# Its https: prefix turns on Secure cookies — required in production.
APP_ORIGIN=https://your-app.vercel.app

# Comma-separated user IDs allowed to see the Operations/admin page. Put your
# admin user's UUID here after seeding (SELECT id FROM users WHERE email=...).
PLATFORM_ADMIN_USER_IDS=

# Do NOT set these two in production:
#   APP_ENV=local              (only for local scripts)
#   APP_RESTRICT_LOCALHOST=true (locks the app to localhost)


# ===== Local seeding (run on your machine, targeting the remote DB) =====
# Used by: npm run db:setup  and  scripts/import-sources.ts
# Set APP_ENV=local for these scripts even when the DB is remote.

# Owner/admin database role (can CREATE ROLE, extensions, run migrations).
# Neon: use the DIRECT (non-pooled) connection string.
#   postgresql://<owner>:<password>@<neon-host>.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_ADMIN_URL=

# Allow seeding a non-local (managed) database. Required to seed Neon.
ALLOW_REMOTE_DB_SETUP=1

# Password given to the seeded demo accounts (min 12 chars). Change it.
DEMO_PASSWORD=

# Actor UUID recorded as the author of scheduled source-sync audit events
# (only needed if you run the sync pipeline).
SYNC_ACTOR_ID=
